{
  "manifest_version": 2,
  "id": "movetoex.longhub",
  "name": "LONG Hub 龙图",
  "version": "0.6.3",
  "description": "同步 LONG Hub 远程表情目录，支持多模态标注、语义/标签/SQL 检索与原生回复扩展。图片仅在内存中处理。",
  "author": {"name": "MoveToEx", "url": "https://example.invalid/MoveToEx"},
  "license": "MIT",
  "urls": {"repository": "https://example.invalid/maibot_plugin_longhub", "documentation": "https://docs.longhub.top"},
  "host_application": {"min_version": "1.3.19", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.20.0", "max_version": "2.99.99"},
  "dependencies": [
    {"type": "python_package", "name": "aiohttp", "version_spec": ">=3.11.18,<4"},
    {"type": "python_package", "name": "aiosqlite", "version_spec": ">=0.21,<1"},
    {"type": "python_package", "name": "sqlalchemy", "version_spec": ">=2.0,<3"},
    {"type": "python_package", "name": "greenlet", "version_spec": ">=3,<4"},
    {"type": "python_package", "name": "pillow", "version_spec": ">=11.2.1"}
  ],
  "capabilities": ["send.hybrid", "llm.generate", "llm.embed", "llm.get_available_models", "maisaka.proactive.trigger"],
  "i18n": {"default_locale": "zh-CN", "locales_path": "_locales", "supported_locales": ["zh-CN"]}
}
